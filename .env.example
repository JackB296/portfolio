# Contact form (Resend) — copy this file to .env.local and fill in.
# Get a key at https://resend.com (free tier).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# Until you verify jbialecki.com in Resend, you can only send FROM Resend's
# shared sender and TO your own account email. After verifying the domain,
# set CONTACT_FROM to something like "Portfolio <hello@jbialecki.com>".
# CONTACT_FROM="Portfolio <onboarding@resend.dev>"
# CONTACT_TO="bialecjr@mail.uc.edu"
